# =============================================================================
# BitSage Validator Dashboard - Mainnet Configuration
# =============================================================================
# Copy this file to .env.local when deploying to Starknet mainnet.
#
# IMPORTANT: All contract addresses MUST be set to valid mainnet deployments.
# The app will refuse to start if any address is missing or set to 0x0.
# =============================================================================

# Network
NEXT_PUBLIC_STARKNET_NETWORK=mainnet
NEXT_PUBLIC_ENABLE_TESTNETS=false

# RPC — use a dedicated mainnet provider (Alchemy, Infura, BlastAPI)
# Public RPCs may throttle or drop requests under load.
NEXT_PUBLIC_RPC_URL=https://starknet-mainnet.public.blastapi.io/rpc/v0_7

# BitSage Coordinator API (production deployment)
NEXT_PUBLIC_API_URL=https://api.bitsage.network
NEXT_PUBLIC_WS_URL=wss://api.bitsage.network/ws

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Demo mode MUST be off for mainnet
NEXT_PUBLIC_DEMO_MODE=false

# =============================================================================
# Mainnet Contract Addresses — REQUIRED
# =============================================================================
# Deploy contracts to mainnet and fill in addresses below.
# The build will fail if any are missing or set to 0x0.

# Core Token
NEXT_PUBLIC_SAGE_TOKEN_ADDRESS=0x_MAINNET_SAGE_TOKEN

# Validator/Worker Contracts (required for this dashboard)
NEXT_PUBLIC_JOB_MANAGER_ADDRESS=0x_MAINNET_JOB_MANAGER
NEXT_PUBLIC_PROVER_STAKING_ADDRESS=0x_MAINNET_PROVER_STAKING
NEXT_PUBLIC_REPUTATION_MANAGER_ADDRESS=0x_MAINNET_REPUTATION_MANAGER

# Trading (for SAGE price display)
NEXT_PUBLIC_OTC_ORDERBOOK_ADDRESS=0x_MAINNET_OTC_ORDERBOOK

# Privacy Pools (referenced by staking/earnings UI)
NEXT_PUBLIC_PRIVACY_POOLS_ADDRESS=0x_MAINNET_PRIVACY_POOLS
NEXT_PUBLIC_CONFIDENTIAL_SWAP_ADDRESS=0x_MAINNET_CONFIDENTIAL_SWAP

# Faucet (disabled on mainnet — leave as placeholder)
NEXT_PUBLIC_FAUCET_ADDRESS=0x0

# =============================================================================
# Price Fallbacks (optional — on-chain oracles are the primary source)
# =============================================================================
# Used ONLY when all on-chain price feeds fail.
# NEXT_PUBLIC_SAGE_FALLBACK_PRICE=0.10
# NEXT_PUBLIC_STRK_FALLBACK_PRICE=0.50

# =============================================================================
# Mainnet Deployment Checklist
# =============================================================================
# 1. Deploy all contracts to Starknet mainnet using contracts/scripts/
# 2. Fill in ALL contract addresses above (none may be 0x0)
# 3. Set NEXT_PUBLIC_RPC_URL to a dedicated mainnet RPC provider
# 4. Set NEXT_PUBLIC_API_URL to the production coordinator
# 5. Verify NEXT_PUBLIC_DEMO_MODE=false
# 6. Run: npm run build (will fail if env validation fails)
# 7. Test wallet connection with ArgentX/Braavos on mainnet
# 8. Verify CSP headers allow your RPC and API domains
# 9. Deploy coordinator node: ./deploy/scripts/setup.sh
# 10. Verify validators can register via CLI: bitsage register

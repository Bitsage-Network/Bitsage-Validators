# BitSage Validator Dashboard
# Next.js web interface for validator management

FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies
COPY package.json package-lock.json* ./
RUN npm ci

# Copy source files
COPY . .

# Set build-time environment variables
ARG NEXT_PUBLIC_RPC_URL
ARG NEXT_PUBLIC_COORDINATOR_URL
ARG NEXT_PUBLIC_WS_URL

ENV NEXT_PUBLIC_RPC_URL=${NEXT_PUBLIC_RPC_URL:-https://starknet-sepolia.public.blastapi.io}
ENV NEXT_PUBLIC_COORDINATOR_URL=${NEXT_PUBLIC_COORDINATOR_URL:-http://localhost:3030}
ENV NEXT_PUBLIC_WS_URL=${NEXT_PUBLIC_WS_URL:-ws://localhost:3030/ws/prover}

# Build Next.js application
RUN npm run build

# Production image
FROM node:20-alpine AS runner

WORKDIR /app

# Set production environment
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy built assets
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

# Set ownership
RUN chown -R nextjs:nodejs /app

USER nextjs

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://localhost:3000/ || exit 1

# Expose port
EXPOSE 3000

# Start server
CMD ["node", "server.js"]

{
  "name": "bitsage-network",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:validator": "turbo dev --filter=@bitsage/validator",
    "dev:governance": "turbo dev --filter=@bitsage/governance",
    "dev:faucet": "turbo dev --filter=@bitsage/faucet",
    "build": "turbo build",
    "build:validator": "turbo build --filter=@bitsage/validator",
    "build:governance": "turbo build --filter=@bitsage/governance",
    "build:faucet": "turbo build --filter=@bitsage/faucet",
    "lint": "turbo lint",
    "clean": "turbo clean && rm -rf node_modules",
    "typecheck": "turbo typecheck",
    "test": "turbo test"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typescript": "^5"
  },
  "packageManager": "npm@10.2.4",
  "engines": {
    "node": ">=18"
  }
}
